# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง
# ห้าม commit ไฟล์ .env เพราะมีรหัสผ่านและ secret

# ---- ฐานข้อมูล ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scheduling"

# ---- เว็บ ----
PORT=3000
FRONTEND_URL="http://localhost:5173"

# ---- เข้าสู่ระบบ (B1) ----
# สุ่มสตริงยาว ๆ อย่างน้อย 32 ตัวอักษร ห้ามใช้ค่าเดียวกับในไฟล์ตัวอย่างนี้
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- อีเมล (B1) ----
# ปล่อย MAIL_FROM ว่างไว้ ระบบจะพิมพ์อีเมลลง console แทนการส่งจริง
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# ---- Discord (B10–B12) ----
# ปล่อยว่างได้ ระบบยังทำงาน แค่ไม่มีการเชื่อมต่อ Discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""